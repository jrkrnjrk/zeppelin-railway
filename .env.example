# Copy these into Railway Variables. Do not commit real secrets.
# Generate KEY with: openssl rand -hex 16

NODE_ENV=production
KEY=

CLIENT_ID=
CLIENT_SECRET=
BOT_TOKEN=

# Your Discord user ID(s), comma-separated
STAFF=

# First guild the bot is allowed to stay in
DEFAULT_ALLOWED_SERVERS=

# Set AFTER Railway gives public domains (no trailing slash)
DASHBOARD_URL=https://REPLACE-DASHBOARD.up.railway.app
API_URL=https://REPLACE-API.up.railway.app

# Leave empty when the API has its own domain
API_PATH_PREFIX=

# Wired from Railway plugins — examples only
DB_HOST=mysql.railway.internal
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=railway

# Required. Official default is redis://redis:6379
REDIS_URL=redis://default:password@redis.railway.internal:6379

# Optional
# PHISHERMAN_API_KEY=
# FISHFISH_API_KEY=
